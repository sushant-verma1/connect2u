{
  "name": "@otp-router/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@otp-router/core": "workspace:*",
    "@otp-router/db": "workspace:*",
    "@otp-router/providers": "workspace:*",
    "argon2": "^0.41.1",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "libphonenumber-js": "^1.11.17",
    "pino": "^9.5.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
