# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres — matches docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/otp_router

# Redis
REDIS_URL=redis://localhost:6379

# Worker — Bull Board (dev only)
WORKER_PORT=3001

# Crypto — generate separately
OTP_PEPPER=
PHONE_HASH_PEPPER=
API_KEY_PEPPER=
PASSWORD_PEPPER=
# 32 random bytes, base64-encoded, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHONE_ENCRYPTION_KEY=
# Same format as PHONE_ENCRYPTION_KEY — must be a distinct key, never reused.
CODE_ENCRYPTION_KEY=

# Meta WhatsApp — set all four to register /v1/webhooks/meta and enable MetaProvider.
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# Shared secret you choose and enter into the Meta app dashboard's webhook subscription.
META_WEBHOOK_VERIFY_TOKEN=
# hello_world is the only template available on a test WABA (PROJECT.md) — swap once an
# authentication template is approved on a production WABA.
META_TEMPLATE_NAME=hello_world
# Off by default, on purpose. Demo-only: sends the code as a free-form WhatsApp session
# message (Meta's 24h customer service window) instead of an authentication template —
# not the production pattern. See README's "WhatsApp session messages (demo only)".
META_ALLOW_SESSION_MESSAGES=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo
DEMO_RECIPIENT_NUMBER=+91XXXXXXXXXX

# Dashboard — the Vite dev server's origin, allowed via CORS to read this API directly.
# Defaults to Vite's own default port; only needed if the dashboard runs elsewhere.
DASHBOARD_ORIGIN=http://localhost:5173

# Which peers may set X-Forwarded-For. The per-IP rate limits are only per-IP if this
# matches the real topology — the dashboard's nginx proxies /v1/* to this API, so
# without it every proxied request shares one bucket. Default covers the same-host Vite
# proxy (loopback) and a docker bridge or Railway internal network (uniquelocal:
# 10/8, 172.16/12, 192.168/16, fc00::/7). Public addresses are deliberately not trusted.
# Only set this if the proxy sits outside those ranges; comma-separated CIDRs/presets.
# TRUST_PROXY=loopback,uniquelocal

# Google sign-in — optional. Both must be set for GET /v1/auth/google to register.
# See README.md's "Sign in with Google" section for the Cloud Console setup and the
# exact redirect URI to register there (built from DASHBOARD_ORIGIN above).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=