# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres — matches docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/otp_router

# Redis
REDIS_URL=redis://localhost:6379

# Worker — Bull Board (dev only)
WORKER_PORT=3001

# Crypto — generate separately
OTP_PEPPER=
PHONE_HASH_PEPPER=
API_KEY_PEPPER=
# 32 random bytes, base64-encoded, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHONE_ENCRYPTION_KEY=
# Same format as PHONE_ENCRYPTION_KEY — must be a distinct key, never reused.
CODE_ENCRYPTION_KEY=

# Meta WhatsApp — set all four to register /v1/webhooks/meta and enable MetaProvider.
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# Shared secret you choose and enter into the Meta app dashboard's webhook subscription.
META_WEBHOOK_VERIFY_TOKEN=
# hello_world is the only template available on a test WABA (PROJECT.md) — swap once an
# authentication template is approved on a production WABA.
META_TEMPLATE_NAME=hello_world

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo
DEMO_RECIPIENT_NUMBER=+91XXXXXXXXXX

# Dashboard — the Vite dev server's origin, allowed via CORS to read this API directly.
# Defaults to Vite's own default port; only needed if the dashboard runs elsewhere.
DASHBOARD_ORIGIN=http://localhost:5173