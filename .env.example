# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres — matches docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/otp_router

# Redis
REDIS_URL=redis://localhost:6379

# Crypto — generate separately
OTP_PEPPER=
PHONE_HASH_PEPPER=
API_KEY_PEPPER=

# Meta WhatsApp
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TEMPLATE_NAME=otp_verification

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo
DEMO_RECIPIENT_NUMBER=+91XXXXXXXXXX