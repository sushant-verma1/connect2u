{
  "name": "@otp-router/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./migrate": "./src/migrate.ts",
    "./repositories/accounts": "./src/repositories/accounts.ts",
    "./repositories/verifications": "./src/repositories/verifications.ts",
    "./repositories/delivery-attempts": "./src/repositories/delivery-attempts.ts",
    "./repositories/webhook-events": "./src/repositories/webhook-events.ts",
    "./repositories/provider-rates": "./src/repositories/provider-rates.ts",
    "./repositories/routing-policies": "./src/repositories/routing-policies.ts",
    "./repositories/channel-capability": "./src/repositories/channel-capability.ts",
    "./repositories/channel-scores": "./src/repositories/channel-scores.ts",
    "./repositories/routing-decisions": "./src/repositories/routing-decisions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/run-migrate.ts"
  },
  "dependencies": {
    "@otp-router/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
